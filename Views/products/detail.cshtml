@{
    Layout = null;  //do not include header & fotter in shared folder (Shared/Layout.cshtml)
}
<html>
    <head>
        <title>Product detail page</title>
    </head>
 
    <body>
        @{
            var product = ViewBag.detail as ProductDto;
        }
 
        <h2>Product Details</h2>
 
        <table border="1" cellpadding="5">
            <tr>
                <th>Id</th>
                <td>@product.Id</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>@product.Name</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>$@product.Price</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>@product.description</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    <img src="@product.image_url" alt="@product.Name" width="150" />
                </td>
            </tr>
            <tr>
                <th>Category Id</th>
                <td>@product.category_id</td>
            </tr>
        </table>
 
    </body>
</html>